# Runtime environment: development, test, or production.
RACECRAFT_ENVIRONMENT=development
RACECRAFT_DEBUG=true
RACECRAFT_HOST=127.0.0.1
RACECRAFT_PORT=8000
RACECRAFT_LOG_LEVEL=INFO
RACECRAFT_FASTF1_CACHE_DIRECTORY=.cache/fastf1

# Comma-separated explicit frontend origins. Wildcards are rejected.
RACECRAFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
